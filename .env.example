# Application
APP_NAME="Earth Analog Finder - Moon & Mars"
APP_VERSION="1.0.0"
DEBUG=true

# Database (SQLite only)
DATABASE_URL="sqlite:///./analog.db"

# Comma separated list of allowed CORS origins ("*" allows everything)
CORS_ORIGINS="*"

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
